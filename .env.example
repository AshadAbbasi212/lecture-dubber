# Copy to .env and adjust. Never commit .env.
APP_ENV=development
SECRET_KEY=change-me
DATABASE_URL=sqlite:///./storage/app.db
STORAGE_DIR=./storage
MAX_UPLOAD_GB=4
MAX_VIDEO_MINUTES=90
RETENTION_DAYS=14
# Local model settings (filled in after Phase 0 decisions)
WHISPER_MODEL=large-v3
WHISPER_COMPUTE_TYPE=int8_float16
TRANSLATION_MODEL=
TTS_MODEL_EN=
TTS_MODEL_UR=
# LIPSYNC_MODEL=   (reserved for the later lip-sync milestone)
